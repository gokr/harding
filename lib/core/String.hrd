#!/usr/bin/env harding
#
# String.nt - String manipulation methods.
# Provides Smalltalk-style string operations.
#
# Note: String class is built-in, we just add methods to it here.

# ====================================================================.
# String class methods (factory methods).
# ====================================================================.

String class>>withCapacity: capacity <primitive primitiveStringWithCapacity: capacity>
  # Create a new String with pre-allocated capacity for efficient appending
  # Usage: buffer := String withCapacity: 1024

# ====================================================================.
# String primitives.
# ====================================================================.

String>>& other <primitive primitiveConcat: other>
  # Concatenate strings with the preferred operator - returns NEW string

String>>size <primitive primitiveStringSize>
  # Return string length

String>>at: index <primitive primitiveStringAt: index>
  # Return the one-character string at a 0-based index

String>>from: start to: end <primitive primitiveFromTo: start to: end>
  # Return substring from start to end (inclusive)

String>>indexOf: substring <primitive primitiveIndexOf: substring>
  # Return the 0-based index of substring, or nil if not found

String>>< other <primitive primitiveLessThan: other>
  # Lexicographic comparison

String>>includesSubString: substring <primitive primitiveIncludesSubString: substring>
  # Check if string includes substring

String>>replace: old with: new <primitive primitiveReplaceWith: old with: new>
  # Replace all occurrences of old with new

String>>uppercase <primitive primitiveUppercase>
  # Return uppercase version

String>>lowercase <primitive primitiveLowercase>
  # Return lowercase version

String>>trim <primitive primitiveTrim>
  # Remove leading and trailing whitespace

String>>split: delimiter <primitive primitiveSplit: delimiter>
  # Split string by delimiter, return array

String>>asInteger <primitive primitiveAsInteger>
  # Parse a complete integer; invalid or out-of-range input answers nil.

String>>asFloat <primitive primitiveAsFloat>
  # Parse a complete float; invalid input answers nil.

String>>asNumber [
  # Prefer integer, then float; invalid input answers nil.
  ^ self asInteger ifNil: [ self asFloat ]
]

String>>asSymbol <primitive primitiveAsSymbol>
  # Convert to symbol

String>>repeat: count <primitive primitiveRepeat: count>
  # Repeat string count times (e.g., "ab" repeat: 3 -> "ababab")

String>><< other <primitive primitiveStringAppend: other>
  # Append in place - MUTATES the string and returns self for chaining
  # Usage: buffer << "text" << " more text"
  # For functional concatenation use & instead

# ====================================================================.
# String printing.
# ====================================================================.

String>>interpolate: bindings [
  # Interpolate $name / $name::slot / ${expression-as-name} in an existing
  # string against a Table of bindings. Triple-quoted literals stay raw; this is
  # the opt-in pass over their text. `\$` stays a literal dollar and unknown
  # names are left untouched. It takes an explicit binding table because a
  # dynamically built string cannot see the caller's locals.
  ^ <primitive primitiveStringInterpolate: bindings>
]

String>>displayString [
  # A string shows its characters, not its quoted literal form.
  ^ self
]

String>>printString [
  # Return the string quoted with double quotes
  ^ "\"" & self & "\""
]

String>>asString [
  # Return the string itself
  ^ self
]

# ====================================================================.
# String convenience methods.
# ====================================================================.

String>>isEmpty [
  # Check if string is empty
  ^ self size = 0
]

String>>notEmpty [
  # Check if string has content
  ^ self size > 0
]

String>>startsWith: prefix <primitive primitiveStartsWith: prefix>

String>>endsWith: suffix <primitive primitiveEndsWith: suffix>

String>>do: aBlock [
  | index |
  index := 0.
  [ index < self size ] whileTrue: [
    aBlock value: (self at: index).
    index := index + 1
  ].
  ^ self
]

String>>species [ ^ Array ]

String>>asArray [
  ^ self collect: [:each | each]
]

String>>first [
  self isEmpty ifTrue: [ ^ nil ].
  ^ self at: 0
]

String>>last [
  self isEmpty ifTrue: [ ^ nil ].
  ^ self at: (self size - 1)
]

String>>includes: substring [
  ^ self includesSubString: substring
]

String>>select: aBlock [
  | text |
  text := "".
  self do: [:each |
    (aBlock value: each) ifTrue: [ text := text & each ]
  ].
  ^ text
]

String>>reject: aBlock [
  ^ self select: [:each | (aBlock value: each) not]
]

String>>reverse [
  | text index |
  text := "".
  index := self size - 1.
  [ index >= 0 ] whileTrue: [
    text := text & (self at: index).
    index := index - 1
  ].
  ^ text
]
