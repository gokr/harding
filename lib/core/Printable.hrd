#!/usr/bin/env harding
#
# Printable.hrd - Printable mixin.

Printable := Mixin derive
# Formatting protocol for sinks that implement write: (for example FileStream).

Printable>>printString [
  ^ "<" & self class name & ">"
]

Printable>>printOn: sink [
  sink write: self printString
]

Printable>>print [
  System stdout write: self printString
]

Printable>>printCr [
  System stdout println: self printString
]

Printable>>displayOn: sink [
  sink write: self displayString
]

Printable>>displayString [
  ^ self printString
]
