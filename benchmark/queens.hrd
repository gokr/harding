#!/usr/bin/env harding
# Count all eight-queens solutions using backtracking (expected: 92).
# Each legal placement allocates a node linked to earlier rows. This exercises
# recursion, allocation, slot access, and dynamic sends, not just integer loops.

QueenPlacement := Object derivePublic: #(row, column, previous).
QueenPlacement>>initializeRow: r column: c previous: p [
  row := r.
  column := c.
  previous := p.
  ^ self
].

Queens := Object derive: #().
Queens>>canPlaceRow: r column: c after: head [
  | current distance delta valid |
  current := head.
  valid := true.
  [current notNil] whileTrue: [
    distance := r - current row.
    delta := c - current column.
    ((delta = 0) | (delta = distance) | (delta = (0 - distance))) ifTrue: [valid := false].
    current := current previous
  ].
  ^ valid
].
Queens>>searchRow: r after: head [
  | column total placement |
  total := 0.
  r = 8 ifTrue: [total := 1] ifFalse: [
    column := 0.
    [column < 8] whileTrue: [
      (self canPlaceRow: r column: column after: head) ifTrue: [
        placement := QueenPlacement new initializeRow: r column: column previous: head.
        total := total + (self searchRow: (r + 1) after: placement)
      ].
      column := column + 1
    ]
  ].
  ^ total
].
Queens>>benchmark [ ^ self searchRow: 0 after: nil ].

# Benchmark driver
solver := Queens new.
answer := solver benchmark.
answer println.
