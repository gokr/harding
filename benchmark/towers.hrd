#!/usr/bin/env harding
# Move 13 linked disk objects between three peg objects (expected: 8191 moves).
# Check every move's legality and the final peg contents. Repeated runs allocate
# fresh disks/pegs and exercise recursive sends and mutable object references.

TowersDisk := Object derivePublic: #(diskSize, nextDisk).
TowersDisk>>initialize: size [ diskSize := size. nextDisk := nil. ^ self ].

Tower := Object derivePublic: #(heldDisk).
Tower>>initialize [ heldDisk := nil. ^ self ].
Tower>>push: disk [
  heldDisk notNil ifTrue: [
    (disk diskSize < heldDisk diskSize) ifFalse: [Error signal: "Illegal disk move"]
  ].
  disk nextDisk: heldDisk.
  heldDisk := disk.
  ^ self
].
Tower>>pop [
  | disk |
  disk := heldDisk.
  disk isNil ifTrue: [Error signal: "Empty source peg"].
  heldDisk := disk nextDisk.
  disk nextDisk: nil.
  ^ disk
].
Tower>>verify: count [
  | disk expected valid |
  disk := heldDisk.
  expected := 1.
  valid := true.
  [disk notNil] whileTrue: [
    disk diskSize = expected ifFalse: [valid := false].
    expected := expected + 1.
    disk := disk nextDisk
  ].
  ^ valid ifTrue: [expected = (count + 1)] ifFalse: [false]
].

Towers := Object derive: #(moves).
Towers>>move: count from: source to: destination using: helper [
  count > 0 ifTrue: [
    self move: (count - 1) from: source to: helper using: destination.
    destination push: source pop.
    moves := moves + 1.
    self move: (count - 1) from: helper to: destination using: source
  ].
  ^ self
].
Towers>>benchmark [
  | source destination helper size |
  moves := 0.
  source := Tower new initialize.
  destination := Tower new initialize.
  helper := Tower new initialize.
  size := 13.
  [size > 0] whileTrue: [
    source push: (TowersDisk new initialize: size).
    size := size - 1
  ].
  self move: 13 from: source to: destination using: helper.
  (destination verify: 13) ifFalse: [Error signal: "Invalid destination peg"].
  source heldDisk notNil ifTrue: [Error signal: "Nonempty source peg"].
  helper heldDisk notNil ifTrue: [Error signal: "Nonempty helper peg"].
  ^ moves
].

# Benchmark driver
solver := Towers new.
answer := solver benchmark.
answer println.
