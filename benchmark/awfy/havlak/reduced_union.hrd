UnionFindNode := Object derive: #(parentState, bbState, dfsNumberState, loop).
UnionFindNode>>initialize [
dfsNumberState := 0.
    ^self
].
UnionFindNode>>initNode: bb dfs: dfsNumber [
parentState := self.
    bbState := bb.
    dfsNumberState := dfsNumber.
    ^self
].
UnionFindNode>>loop [
^ loop.
    ^self
].
UnionFindNode>>loop: aLoop [
loop := aLoop.
    ^self
].
UnionFindNode>>findSet [
| nodeList node |
    nodeList := Vector new.

    node := self.

    [node ~= node parent] whileTrue: [
      ((node parent) ~= (node parent parent)) ifTrue: [
        nodeList append: node ].
      node := node parent ].

    nodeList forEach: [:iter | iter union: parentState ].
    ^ node.
    ^self
].
UnionFindNode>>union: basicBlock [
parentState := basicBlock.
    ^self
].
UnionFindNode>>parent [
^ parentState.
    ^self
].
UnionFindNode>>bb [
^ bbState.
    ^self
].
UnionFindNode>>dfsNumber [
^ dfsNumberState.
    ^self
].
UnionFindNode class>>new [
^ super new initialize.
    ^self
].

