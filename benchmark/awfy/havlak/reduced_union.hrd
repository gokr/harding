# SOM arrays are 1-based. Keep their indexing at the port boundary.
HavlakArray := Object derive: #(storage).
HavlakArray class>>new: size [^super new initialize: size].
HavlakArray class>>with: first with: second [
    | array |
    array := self new: 2.
    array at: 1 put: first.
    array at: 2 put: second.
    ^array
].
HavlakArray>>initialize: size [storage := Array new: size. ^self].
HavlakArray>>at: index [^storage at: index - 1].
HavlakArray>>at: index put: value [^storage at: index - 1 put: value].
HavlakArray>>length [^storage size].
HavlakArray>>doIndexes: block [1 to: storage size do: block].
HavlakArray>>do: block [storage do: block].

# Portable nonnegative operations pending generic Integer bitwise APIs.
HavlakBits := Object derive.
HavlakBits class>>xor: left with: right [
    | a b place answer |
    a := left. b := right. place := 1. answer := 0.
    [(a > 0) or: [b > 0]] whileTrue: [
        (a \\ 2) <> (b \\ 2) ifTrue: [answer := answer + place].
        a := a // 2. b := b // 2. place := place * 2
    ].
    ^answer
].
HavlakBits class>>and: left with: right [
    | a b place answer |
    a := left. b := right. place := 1. answer := 0.
    [(a > 0) and: [b > 0]] whileTrue: [
        ((a \\ 2) = 1 and: [(b \\ 2) = 1]) ifTrue: [answer := answer + place].
        a := a // 2. b := b // 2. place := place * 2
    ].
    ^answer
].

Vector := Object derive: #(first, last, storage).
Vector>>initialize: size [
first := 1.
    last  := 1.

    size = 0
      ifFalse: [ storage := HavlakArray new: size ].
    ^self
].
Vector>>at: index [
(storage == nil or: [ index > storage length ]) ifTrue: [ ^ nil ].
    ^ storage at: index.
    ^self
].
Vector>>at: index put: val [
storage == nil ifTrue: [
      storage := HavlakArray new: (index max: 10)
    ] ifFalse: [
      index > storage length ifTrue: [
        | newLength newStorage |
        newLength := storage length.
        [ newLength < index ] whileTrue: [
          newLength := newLength * 2 ].
        newStorage := HavlakArray new: newLength.
        storage doIndexes: [:i | newStorage at: i put: (storage at: i) ].
        storage := newStorage ] ].

    storage at: index put: val.
    last < (index + 1) ifTrue: [
      last := index + 1 ].
    ^self
].
Vector>>append: element [
storage == nil ifTrue: [
      storage := HavlakArray new: 10
    ] ifFalse: [
      last > storage length ifTrue: [

        | newStorage |
        newStorage := HavlakArray new: (2 * storage length).
        storage doIndexes: [ :i | newStorage at: i put: (storage at: i) ].
        storage := newStorage ] ].

    storage at: last put: element.
    last := last + 1.
    ^ self.
    ^self
].
Vector>>isEmpty [
^ last = first.
    ^self
].
Vector>>forEach: block [
first to: last - 1 do: [ :i | block value: (storage at: i) ].
    ^self
].
Vector>>hasSome: block [
first to: last - 1 do: [ :i |
      (block value: (storage at: i))
        ifTrue: [ ^ true ] ].
    ^ false.
    ^self
].
Vector>>getOne: block [
first to: last - 1 do: [ :i |
      | e |
      e := storage at: i.
      (block value: e)
        ifTrue: [ ^ e ] ].
    ^ nil.
    ^self
].
Vector>>removeFirst [
self isEmpty ifTrue: [ ^ nil ].
    first := first + 1.
    ^ storage at: first - 1.
    ^self
].
Vector>>removeAll [
first := 1.
    last  := 1.

    storage == nil ifFalse: [
      storage := HavlakArray new: storage length
    ].
    ^self
].
Vector>>remove: object [
| newArray newLast found |
    (storage == nil or: [ self isEmpty ]) ifTrue: [ ^ false ].

    newArray := HavlakArray new: self capacity.
    newLast := 1.
    found := false.

    self forEach: [ :it |
      it == object
          ifTrue:  [ found := true ]
          ifFalse: [
              newArray at: newLast put: it.
              newLast := newLast + 1 ] ].

    storage := newArray.
    last := newLast.
    first := 1.
    ^ found.
    ^self
].
Vector>>size [
^ last - first.
    ^self
].
Vector>>capacity [
storage == nil ifTrue: [ ^ 0 ] ifFalse: [ ^ storage length ].
    ^self
].
Vector class>>new [
^ self new: 0.
    ^self
].
Vector class>>new: initialSize [
^ super new initialize: initialSize.
    ^self
].
Vector class>>with: elem [
| newVector |
    newVector := self new: 1.
    newVector append: elem.
    ^ newVector.
    ^self
].

