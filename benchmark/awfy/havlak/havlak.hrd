SomDictionary := Object derive: #(buckets, sizeState).
SomDictionary>>initialize: size [
buckets := HavlakArray new: size.
    sizeState   := 0.
    ^self
].
SomDictionary>>hash: key [
| hash |
    key ifNil: [ ^ 0 ].
    hash := key customHash.
    ^ HavlakBits xor: hash with: (hash // 65536).
    ^self
].
SomDictionary>>bucketIdx: hash [
^ 1 + (hash \\ buckets length).
    ^self
].
SomDictionary>>bucket: hash [
^ buckets at: (self bucketIdx: hash).
    ^self
].
SomDictionary>>at: aKey [
| hash e |
    hash := self hash: aKey.
    e    := self bucket: hash.

    [ e notNil ] whileTrue: [
      (e match: hash key: aKey)
        ifTrue: [ ^ e value ].
      e := e next ].
    ^ nil.
    ^self
].
SomDictionary>>containsKey: aKey [
| hash e |
    hash := self hash: aKey.
    e    := self bucket: hash.

    [ e notNil ] whileTrue: [
      (e match: hash key: aKey)
        ifTrue: [ ^ true ].
      e := e next ].
    ^ false.
    ^self
].
SomDictionary>>at: aKey put: aVal [
| hash i current |
    hash := self hash: aKey.
    i    := self bucketIdx: hash.
    current := buckets at: i.

    current
      ifNil: [
        buckets at: i put: (self newEntry: aKey value: aVal hash: hash).
        sizeState := sizeState + 1 ]
      ifNotNil: [:ignored |
        self insertBucketEntry: aKey value: aVal hash: hash head: current ].

    sizeState > buckets length ifTrue: [ self resize ].
    ^self
].
SomDictionary>>newEntry: aKey value: value hash: hash [
^ DictEntry new: hash key: aKey value: value next: nil.
    ^self
].
SomDictionary>>insertBucketEntry: key value: value hash: hash head: head [
| current |
    current := head.

    [true] whileTrue: [
      (current match: hash key: key) ifTrue: [
        current value: value.
        ^ self ].
      current next ifNil: [
        sizeState := sizeState + 1.
        current next: (self newEntry: key value: value hash: hash).
        ^ self ].
      current := current next ].
    ^self
].
SomDictionary>>resize [
| oldStorage |
    oldStorage := buckets.
    buckets := HavlakArray new: oldStorage length * 2.
    self transferEntries: oldStorage.
    ^self
].
SomDictionary>>transferEntries: oldStorage [
1 to: oldStorage length do: [:i |
      | current |
      current := oldStorage at: i.
      current ifNotNil: [:ignored |
        oldStorage at: i put: nil.
        current next
          ifNil: [
            buckets at: 1 + (current hash \\ buckets length) put: current ]
          ifNotNil: [:ignored |
            self splitBucket: oldStorage bucket: i head: current ] ] ].
    ^self
].
SomDictionary>>splitBucket: oldStorage bucket: i head: head [
| loHead loTail hiHead hiTail current |
    loHead := nil. loTail := nil.
    hiHead := nil. hiTail := nil.
    current := head.

    [ current notNil ] whileTrue: [
      (HavlakBits and: current hash with: oldStorage length) = 0
        ifTrue: [
          loTail
            ifNil:    [ loHead := current ]
            ifNotNil: [:ignored | loTail next: current ].
          loTail := current ]
        ifFalse: [
          hiTail
            ifNil:    [ hiHead := current ]
            ifNotNil: [:ignored | hiTail next: current ].
          hiTail := current ].
      current := current next ].

    loTail ifNotNil: [:ignored |
      loTail next: nil.
      buckets at: i put: loHead ].
    hiTail ifNotNil: [:ignored |
      hiTail next: nil.
      buckets at: i + oldStorage length put: hiHead ].
    ^self
].
SomDictionary>>size [
^ sizeState.
    ^self
].
SomDictionary>>isEmpty [
^ sizeState = 0.
    ^self
].
SomDictionary>>removeAll [
buckets := HavlakArray new: buckets length.
    sizeState := 0.
    ^self
].
SomDictionary>>keys [
| keys |
    keys := Vector new: sizeState.
    buckets do: [:b |
      | current |
      current := b.
      [ current notNil ] whileTrue: [
        keys append: current key.
        current := current next ] ].
    ^ keys.
    ^self
].
SomDictionary>>values [
| values |
    values := Vector new: sizeState.
    buckets do: [:b |
      | current |
      current := b.
      [ current notNil ] whileTrue: [
        values append: current value.
        current := current next ] ].
    ^ values.
    ^self
].
SomDictionary class>>new: size [
^ super new initialize: size.
    ^self
].
SomDictionary class>>new [
^ self new: 16.
    ^self
].

