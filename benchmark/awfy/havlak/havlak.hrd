SomIdentityDictionary := SomDictionary derive: #().
SomIdentityDictionary>>newEntry: aKey value: value hash: hash [
^ DictIdEntry new: hash key: aKey value: value next: nil.
    ^self
].
SomIdentityDictionary class>>new [
^ super new: 16.
    ^self
].

