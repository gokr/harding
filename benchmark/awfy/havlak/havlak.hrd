DictEntry := Object derive: #(hash, key, value, next).
DictEntry>>init: aHash key: aKey value: val next: anEntry [
hash  := aHash.
    key   := aKey.
    value := val.
    next  := anEntry.
    ^self
].
DictEntry>>hash [
^ hash.
    ^self
].
DictEntry>>key [
^ key.
    ^self
].
DictEntry>>value [
^ value.
    ^self
].
DictEntry>>value: val [
value := val.
    ^self
].
DictEntry>>next [
^ next.
    ^self
].
DictEntry>>next: e [
next := e.
    ^self
].
DictEntry>>match: aHash key: aKey [
^ hash = aHash and: [key = aKey].
    ^self
].
DictEntry class>>new: hash key: key value: val next: next [
^ self new init: hash key: key value: val next: next.
    ^self
].

