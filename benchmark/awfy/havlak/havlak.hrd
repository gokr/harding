BasicBlock := Object derive: #(inEdges, outEdges, name).
BasicBlock>>init: aName [
inEdges  := Vector new: 2.
    outEdges := Vector new: 2.
    name     := aName.
    ^self
].
BasicBlock>>inEdges [
^ inEdges.
    ^self
].
BasicBlock>>outEdges [
^ outEdges.
    ^self
].
BasicBlock>>numPred [
^ inEdges size.
    ^self
].
BasicBlock>>addOutEdge: to [
outEdges append: to.
    ^self
].
BasicBlock>>addInEdge: from [
inEdges append: from.
    ^self
].
BasicBlock>>customHash [
^ name.
    ^self
].
BasicBlock class>>new: name [
^ self new init: name.
    ^self
].

