SomIdentitySet := SomSet derive: #().
SomIdentitySet>>contains: anObject [
^ self hasSome: [ :it |  it == anObject ].
    ^self
].
SomIdentitySet class>>new: size [
^ super new initialize: size.
    ^self
].

