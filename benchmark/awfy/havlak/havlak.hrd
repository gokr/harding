DictIdEntry := DictEntry derive: #().
DictIdEntry>>match: aHash key: aKey [
^ hash = aHash and: [key == aKey].
    ^self
].
DictIdEntry class>>new: hash key: key value: val next: next [
^ self new init: hash key: key value: val next: next.
    ^self
].

