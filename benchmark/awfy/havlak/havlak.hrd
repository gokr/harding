SimpleLoop := Object derive: #(counter, depthLevel, parentState, isRootState, nestingLevelState, header, isReducible, basicBlocks, children).
SimpleLoop>>init: aBB reducible: aBool [
counter    := 0.
    depthLevel := 0.

    isRootState := false.
    nestingLevelState := 0.
    header  := aBB.
    isReducible := aBool.
    basicBlocks := SomIdentitySet new.
    children    := SomIdentitySet new.

    aBB ifNotNil: [:ignored | basicBlocks add: aBB ].
    ^self
].
SimpleLoop>>counter [
^ counter.
    ^self
].
SimpleLoop>>counter: val [
counter := val.
    ^self
].
SimpleLoop>>depthLevel [
^ depthLevel.
    ^self
].
SimpleLoop>>depthLevel: val [
depthLevel := val.
    ^self
].
SimpleLoop>>children [
^ children.
    ^self
].
SimpleLoop>>addNode: bb [
basicBlocks add: bb.
    ^self
].
SimpleLoop>>addChildLoop: loop [
children add: loop.
    ^self
].
SimpleLoop>>parent [
^ parentState.
    ^self
].
SimpleLoop>>parent: val [
parentState := val.
    parentState addChildLoop: self.
    ^self
].
SimpleLoop>>isRoot [
^ isRootState.
    ^self
].
SimpleLoop>>setIsRoot [
isRootState := true.
    ^self
].
SimpleLoop>>nestingLevel [
^ nestingLevelState.
    ^self
].
SimpleLoop>>nestingLevel: level [
nestingLevelState := level.
    level = 0 ifTrue: [ self setIsRoot ].
    ^self
].
SimpleLoop class>>basicBlock: bb reducible: isReducible [
^ self new init: bb reducible: isReducible.
    ^self
].

